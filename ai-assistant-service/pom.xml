<project xmlns="[maven.apache.org](http://maven.apache.org/POM/4.0.0)"
         xmlns:xsi="[w3.org](http://www.w3.org/2001/XMLSchema-instance)"
         xsi:schemaLocation="[maven.apache.org](http://maven.apache.org/POM/4.0.0)
                             [maven.apache.org](https://maven.apache.org/xsd/maven-4.0.0.xsd)">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.example</groupId>
    <artifactId>taskmanager-microservices</artifactId>
    <version>1.0.0</version>
    <relativePath>..</relativePath>
  </parent>

  <artifactId>ai-assistant-service</artifactId>
  <packaging>jar</packaging>
  <name>AI Assistant Service</name>

  <dependencies>
    <!-- Dépendance au module frère: pas de version nécessaire -->
    <dependency>
      <groupId>com.example</groupId>
      <artifactId>ai-common-library</artifactId>
    </dependency>

    <!-- Dépendances Spring Boot spécifiques -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
